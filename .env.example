# Google Cloud service account JSON (single line). Base64-encoded JSON also works.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SPREADSHEET_ID=

# Signs session unlock tokens after PIN verify (use a long random string in production)
SESSION_AUTH_SECRET=

# Tab names (defaults shown)
SHEET_SESSIONS=Sessions
SHEET_COUNTERS=Counters
SHEET_LOCATIONS=Locations
SHEET_SKUS=SKUs
SHEET_COUNTS=Counts
SHEET_ASSIGNMENTS=Assignments
SHEET_LOCATION_MAP=LocationMap
SHEET_SYSTEM_STOCK=SystemStock

# Optional: zero-based column indexes if your sheet layout differs
# COL_LOCATION_MAP_LOCATION=0
# COL_LOCATION_MAP_GUDANG=1
# COL_LOCATION_MAP_SKU=2
# COL_SYSTEM_STOCK_SESSION_ID=0
# COL_SYSTEM_STOCK_SKU=1
# COL_SYSTEM_STOCK_GUDANG=2
# COL_SYSTEM_STOCK_QTY=3
# COL_ASSIGNMENT_SESSION_ID=0
# COL_ASSIGNMENT_LOCATION=1
# COL_ASSIGNMENT_NAME=2
# COL_ASSIGNMENT_SKU=3
# COL_SESSION_ID=0
# COL_SESSION_NAME=1
# COL_SESSION_STATUS=2
